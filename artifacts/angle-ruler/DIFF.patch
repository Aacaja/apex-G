-  std::uint64_t h =
-      HashBytesContinue(14695981039346656037ULL, &g.width, sizeof(g.width));
-  h = HashBytesContinue(h, &g.height, sizeof(g.height));
-  h = HashBytesContinue(h, g.pixels.data(), g.pixels.size());
-  return h;
