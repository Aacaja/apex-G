+  static int Sign(double pitch_deg) {
+    if (!std::isfinite(pitch_deg) ||
+        std::fabs(pitch_deg) <= kPitchSignNeutralBandDeg) {
+      return 0;
+    }
+    return pitch_deg < 0.0 ? -1 : 1;
+  }
