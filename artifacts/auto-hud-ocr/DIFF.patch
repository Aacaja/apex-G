+BinaryGrid MultilineHudScanCanvas() {
+  BinaryGrid scan;
+  scan.width = 720;
+  scan.height = 280;
+  scan.pixels.assign(static_cast<std::size_t>(scan.width) * scan.height, 0);
+  for (int y = 0; y < apex_hud_multiline_fixture::kHeight; ++y) {
+    for (int x = 0; x < apex_hud_multiline_fixture::kWidth; ++x) {
