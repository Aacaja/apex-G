+  result.pixels.assign(static_cast<std::size_t>(result.width) * result.height, 0);
+  for (int y = 0; y < result.height; ++y) {
+    for (int x = 0; rows[y][x] != '\0'; ++x) {
+      if (rows[y][x] == '#') result.Set(x, y, 1);
