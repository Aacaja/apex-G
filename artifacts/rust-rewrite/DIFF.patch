+int WINAPI wWinMain(HINSTANCE instance, HINSTANCE, PWSTR, int) {
+  App app;
+  if (!app.Initialize(instance)) {
+    MessageBoxW(nullptr, L"Apex Arc Assist 初始化失败。", kTitle,
+                MB_OK | MB_ICONERROR);
+    return 1;
+  }
+  const int result = app.Run();
+  app.Shutdown();
+  return result;
+}
